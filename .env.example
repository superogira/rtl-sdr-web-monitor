# ============================================
# RTL-SDR Web Monitor - Configuration
# ============================================
# Copy this file to .env and edit values

# === Application ===
APP_NAME=RTL-SDR Monitor
APP_ENV=development
DEBUG=true
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# === JWT Authentication ===
JWT_SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./data/rtl_sdr.db

# === RTL-TCP Connection ===
RTL_TCP_HOST=127.0.0.1
RTL_TCP_PORT=1234

# === Default SDR Settings ===
DEFAULT_FREQUENCY=145500000
DEFAULT_SAMPLE_RATE=2048000
DEFAULT_GAIN=30
DEFAULT_DEMOD_MODE=FM
DEFAULT_SQUELCH=-80

# === Recording ===
RECORDINGS_DIR=./data/recordings
RECORDING_FORMAT=wav
AUTO_RECORD=true
SIGNAL_THRESHOLD=-80
MIN_RECORDING_DURATION=2
MAX_RECORDING_DURATION=300
SILENCE_TIMEOUT=5

# === Speech-to-Text ===
STT_PROVIDER=whisper
SPEECHMATICS_API_KEY=
SPEECHMATICS_LANGUAGE=th
WHISPER_MODEL=base
WHISPER_LANGUAGE=th

# === Telegram Notifications ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# === Keywords (comma-separated) ===
ALERT_KEYWORDS=ฉุกเฉิน,เหตุด่วน,help,emergency