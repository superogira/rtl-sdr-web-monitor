# ============================================
# RTL-SDR Web Monitor - Configuration
# ============================================
# Copy this file to .env and edit values

# === Application ===
APP_NAME=RTL-SDR Monitor
APP_ENV=development
# Default is false to avoid SQL echo logging overhead. Set to true only for debugging.
DEBUG=false
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# === JWT Authentication ===
JWT_SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./data/rtl_sdr.db

# === RTL-TCP Connection ===
RTL_TCP_HOST=127.0.0.1
RTL_TCP_PORT=1234

# === Default SDR Settings ===
DEFAULT_FREQUENCY=145500000
DEFAULT_SAMPLE_RATE=2048000
DEFAULT_GAIN=30
DEFAULT_DEMOD_MODE=FM
DEFAULT_SQUELCH=-80

# === Recording ===
RECORDINGS_DIR=./data/recordings
RECORDING_FORMAT=wav
AUTO_RECORD=true
SIGNAL_THRESHOLD=-80
MIN_RECORDING_DURATION=2
MAX_RECORDING_DURATION=300
SILENCE_TIMEOUT=5

# === Speech-to-Text ===
STT_PROVIDER=speechmatics  # speechmatics | azure | whisper_local | groq | maxplus
SPEECHMATICS_API_KEY=
SPEECHMATICS_LANGUAGE=th
# Groq Whisper API (optional; can also be set in Settings UI)
# Get an API key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
# MaxPlus AI (optional; can also be set in Settings UI)
# OpenAI-compatible transcription API — https://maxplus-ai.cc/docs/api
# Get an API key from the MaxPlus AI dashboard (key format: ccsk-...)
MAXPLUS_API_KEY=
MAXPLUS_STT_MODEL=whisper-large-v3  # e.g. whisper-large-v3 | grok-stt
# Whisper Local (faster-whisper-server / OpenAI-compatible REST API)
# See docs/WHISPER_LOCAL_STT.md for setup instructions.
WHISPER_LOCAL_HOST=192.168.1.201
WHISPER_LOCAL_PORT=8100
WHISPER_LOCAL_MODEL=Systran/faster-whisper-small
WHISPER_LOCAL_TASK=transcribe  # transcribe | translate
WHISPER_LOCAL_TEMPERATURE=0.0
# Azure Cognitive Services Speech (optional; can also be set in Settings UI)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
AZURE_SPEECH_LANGUAGE=th-TH

# === Telegram Notifications ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# === Keywords (comma-separated) ===
ALERT_KEYWORDS=ฉุกเฉิน,เหตุด่วน,help,emergency
# === Auto-start streaming (24/7 background operation) ===
# When true, server will auto-connect to RTL-TCP and start streaming on startup.
# If RTL-TCP is offline, it will retry every AUTO_START_RETRY_INTERVAL seconds.
AUTO_START_STREAMING=true
AUTO_START_RETRY_INTERVAL=10
AUTO_START_MAX_RETRIES=0
